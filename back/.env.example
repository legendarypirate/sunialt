PORT=3071
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sunialt
DB_USER=postgres
DB_PASSWORD=your_password

JWT_SECRET=change_this_to_a_long_random_secret
ADMIN_EMAIL=admin@sunia.mn
ADMIN_PASSWORD=admin123
# QPay merchant (https://merchant.qpay.mn) — same pattern as menall/tenkhee
QPAY_BASE_URL=https://merchant.qpay.mn/v2
QPAY_LOGIN=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
QPAY_RECEIVER_CODE=DEFAULT_COM_ID
QPAY_CALLBACK_URL=
QPAY_USE_DOH_FALLBACK=1
# Aliases also supported: QPAY_CLIENT_ID / QPAY_CLIENT_SECRET
# Set QPAY_ALLOW_DEMO=1 to allow demo invoices when credentials are missing
SUBSCRIPTION_PRICE=19900

# Web + iOS audience + Men iOS + Suniagch iOS (mn.push.uper) + Suniagch Android
GOOGLE_CLIENT_IDS=536553320418-iiho2bkqg3kvn55e31lreem2shhhl444.apps.googleusercontent.com,536553320418-4vifnpul3iqk22kb3c0l0f3qot691unt.apps.googleusercontent.com,536553320418-e75lvofnha7nqlt122sq01u2cfahgut2.apps.googleusercontent.com,536553320418-cgbu2tve552kol3193bfbottairinh7o.apps.googleusercontent.com,536553320418-117ftm66hsn75tcjnk1kudnonvbnv97r.apps.googleusercontent.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Cloud Messaging (download service account from Firebase Console)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Or inline JSON (single line):
# FIREBASE_SERVICE_ACCOUNT_JSON=
FCM_APNS_TOPIC=mn.push.uper

# Daily goal reminder — 19:30 Ulaanbaatar if todayPushUps < dailyGoalReps
APP_TIME_ZONE=Asia/Ulaanbaatar
DAILY_GOAL_REMINDER_HOUR=19
DAILY_GOAL_REMINDER_MINUTE=30
# FORCE_DAILY_GOAL_REMINDER=1  # skip time check (manual test only)

# If uploads return 413 behind nginx, set: client_max_body_size 25M;
